{
    "compilerOptions": {
        "target": "es2019",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "sourceMap": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
