{
  "name": "cuniform",
  "version": "0.0.1",
  "description": "a 3D viewer for saved neural networks",
  "private": true,
  "scripts": {
    "start": "npm run typecheck && npx webpack --config webpack.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "bench": "rm -rf .test-build && tsc -p tsconfig.test.json && node --expose-gc .test-build/bench/physics.bench.js",
    "ci": "npm run typecheck && npm test",
    "dev": "npx webpack --watch --config webpack.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidbarkhuizen/cuniform.git"
  },
  "keywords": [],
  "author": "david barkhuizen",
  "license": "MPL-2.0",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild-loader": "^4.5.0",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
