#!/usr/bin/env bash

set -euo pipefail

# cuniform command line entry point.
#
# The node/npm equivalent of the reference project's `cli` script. Run it from
# the repository root:
#
#   ./cli [ bench | build | ci | clean | help | install | run | test | typecheck ]
#
# With no recognised option it prints usage. Unlike the reference, which falls
# through to running the program, `run` must be asked for explicitly.

option="${1:-}"

# `shift` on an empty argument list is an error, and under `set -e` that would
# abort before the usage text could print; only shift when there is an argument.
if [ "$#" -gt 0 ]; then
    shift 1
fi

clean () {

    # The reference defeats stale build caches by touching every file. Here the
    # only build outputs are webpack's bundle and the test compilation, so
    # removing them achieves the same "force everything to rebuild" result
    # without needing sudo.
    rm -rf dist .test-build
    echo "... cleaned build artefacts"
}

install () {

    npm install
}

typecheck () {

    npm run typecheck
}

test () {

    npm test
}

ci () {

    npm run ci
}

bench () {

    npm run bench
}

build () {

    echo "building js from typescript ..."
    npm run start
    echo "... built"
}

run () {

    bash build-and-run.sh
}

usage () {
    echo "-----------------------------------------------"
    echo "cuniform - force directed graphs"
    echo "-----------------------------------------------"
    echo "usage:"
    echo
    echo "./cli [ bench | build | ci | clean | help | install | run | test | typecheck ]"
    echo
    echo
    echo "./cli run"
}

case "$option" in

    bench)
        bench
    ;;

    build)
        build
    ;;

    ci)
        ci
    ;;

    clean)
        clean "$@"
    ;;

    install)
        install
    ;;

    test)
        test
    ;;

    typecheck)
        typecheck
    ;;

    run)
        run
    ;;

    help)
        usage
    ;;

    *)
        usage
    ;;

esac
